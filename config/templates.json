[
  {
    "name": "sandbox-base",
    "image": "ghcr.io/agent-sandbox/sandbox-base:latest",
    "port": 49983,
    "description": "sandbox base with python:3.12"
  },
  {
    "name": "sandbox-base-node",
    "image": "ghcr.io/agent-sandbox/sandbox-base-node:latest",
    "port": 49983,
    "description": "sandbox base with node:22"
  },
  {
    "name": "sandbox-base-code",
    "image": "ghcr.io/agent-sandbox/sandbox-base-code:latest",
    "port": 49983,
    "description": "sandbox base with python:3.12 and code interpreter"
  },
  {
    "name": "sandbox-base",
    "image": "ghcr.io/agent-sandbox/sandbox-base:latest",
    "port": 49983,
    "resources": {
      "cpu": "0.2",
      "memory": "200Mi",
      "cpuLimit": "1",
      "memoryLimit": "1Gi"
    },
    "metadata": {
      "runtimeClassName": "gvisor",
      "shareDataNFS": "100.100.100.100"
    },
    "description": "sandbox base with python:3.12 and gvisor runtime"
  },
  {
    "name": "sandbox-base-biz",
    "pattern": "faas-code-(?P<name>.+)\\.(?P<version>.+)$",
    "image": "ghcr.io/agent-sandbox/<name>:<version>",
    "type": "dynamic",
    "port": 49999,
    "description": "providing a dynamic sandbox-base environment."
  }
]

